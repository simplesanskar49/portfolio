# Copy to .env.local for local builds; set the same keys in Vercel
# (Project -> Settings -> Environment Variables, Production).
# All are read at build time and end up in the public HTML.

# Optional: override the public origin (default https://sanskar-kumar.vercel.app),
# e.g. for a custom domain. No trailing slash. Used by canonical, Open Graph,
# JSON-LD, robots.txt, sitemap.xml and llms.txt.
VITE_SITE_URL=

# Optional: ownership tokens from Google Search Console / Bing Webmaster Tools
# (HTML tag method, copy only the content="..." value). Google's token for
# sanskar-kumar.vercel.app is already the default in src/constants/site.ts.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
